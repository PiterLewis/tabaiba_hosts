# Web3Forms access key (https://web3forms.com)
# 1. Ve a https://web3forms.com/, pon tabaibahosts@gmail.com en "Create Access Key"
# 2. Te llega un mail con tu access_key
# 3. Copia este archivo a .env.local y pega aquí la clave
# 4. Reinicia el dev server (npm run dev) para que coja la variable
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Backend de Tabaiba Hosts (Fastify + PostgreSQL).
# - En producción: https://api.tabaibahosts.com
# - En desarrollo, si levantas el backend en local: http://localhost:3001
# Lo lee tanto el cliente (porque empieza por NEXT_PUBLIC_) como el
# middleware (Edge runtime, mismo nombre).
NEXT_PUBLIC_API_URL=https://api.tabaibahosts.com
